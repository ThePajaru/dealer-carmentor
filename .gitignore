# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# claude code (local worktrees + local-only settings; settings.json stays tracked but must never contain secrets)
.claude/worktrees/
.claude/settings.local.json*
.git-broken/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# playwright mcp
.playwright-mcp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# La plantilla sin secretos si se versiona; .env.local nunca.
!.env.example
