# ── Lo propio de este despliegue ─────────────────────────────────────────
# El dominio publico DE ESTA app: enlaces que el dealer pega fuera (bio de
# Instagram, WhatsApp), redirects de Stripe y CTAs de los correos.
NEXT_PUBLIC_BASE_URL="https://dealer.carmentor.es"

# Donde vive el motor de analisis, que se queda en la app de consumo.
# En el monolito esto era la misma variable de arriba; al separar, no lo es.
# Si esto apunta aqui, TODOS los analisis fallan con 404.
CARMENTOR_ENGINE_URL="https://carmentor.es"

